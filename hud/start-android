#!/usr/bin/python3
import signal
import subprocess
import sys

# The official app command waits for Android's user-unlocked callback before
# launching the game, and owns the session loop on a cold start. show-full-ui
# expands the notification shade; racing a separate boot-property poll against
# that callback can leave the shade above the game.
session = subprocess.Popen([
    '/usr/bin/waydroid', 'app', 'launch', 'com.hypergryph.arknights',
])
def stop(signum, frame):
    session.terminate()
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
try:
    sys.exit(session.wait())
finally:
    if session.poll() is None:
        session.terminate()
